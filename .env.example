# Copy this file to `.env` and replace the placeholder values.
#
# The CLI and example scripts load `.env` automatically by default.
# Explicit command-line flags still take precedence over these values.

# ---------------------------------------------------------------------------
# Sentinel Hub Process API credentials
# Use these for raw Sentinel-2 patch fetches, e.g.:
#   python examples/switzerland_patch/fetch_raw_patch.py --bands B04 B08
# ---------------------------------------------------------------------------
TERRAVAULT_CDSE_SH_CLIENT_ID=your_sentinel_hub_oauth_client_id
TERRAVAULT_CDSE_SH_CLIENT_SECRET=your_sentinel_hub_oauth_client_secret

# ---------------------------------------------------------------------------
# Optional CDSE account credentials for catalogue/product download flows
# Use these for `terravault run` when you want TerraVault to request a token
# on your behalf with the default public client.
# ---------------------------------------------------------------------------
# TERRAVAULT_CDSE_USERNAME=your_cdse_username
# TERRAVAULT_CDSE_PASSWORD=your_cdse_password
# TERRAVAULT_CDSE_TOTP=123456
# TERRAVAULT_CDSE_CLIENT_ID=cdse-public

# ---------------------------------------------------------------------------
# Optional pre-issued bearer token for catalogue/product downloads
# If set, it is used instead of TERRAVAULT_CDSE_USERNAME/PASSWORD.
# ---------------------------------------------------------------------------
# TERRAVAULT_CDSE_ACCESS_TOKEN=your_existing_cdse_bearer_token

# ---------------------------------------------------------------------------
# CDSE S3 credentials for native-resolution rolling ingestion
# Generate these separately in the CDSE S3 credentials portal. Sentinel Hub
# OAuth credentials and CDSE account passwords do not work as S3 keys.
# ---------------------------------------------------------------------------
# TERRAVAULT_CDSE_S3_ACCESS_KEY=your_s3_access_key
# TERRAVAULT_CDSE_S3_SECRET_KEY=your_s3_secret_key
# TERRAVAULT_CDSE_S3_ENDPOINT=https://eodata.dataspace.copernicus.eu
# TERRAVAULT_CDSE_S3_REGION=default
